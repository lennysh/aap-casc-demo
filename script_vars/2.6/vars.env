#!/bin/bash
# Environment variables for AAP 2.6

# Shown next to this version in start_here.sh
aap_version_label="Controller, Platform Gateway, EDA and Automation Hub"

execution_environment="quay.io/lshirley/ansible-automation-platform-26/ee-casc-rhel9-git"

# --- Export Tags ---

export_category_tags=(
  "controller"
  "gateway"
  "eda"
  "hub"
)

export_specific_tags_categories=(
  "Controller"
  "Gateway"
  "Event-Driven Ansible (EDA)"
  "Automation Hub (HUB)"
)

declare -A export_specific_tags
export_specific_tags["Controller"]="controller_applications controller_credential_types controller_credentials controller_execution_environments controller_groups controller_hosts controller_instance_groups controller_instances controller_inventories controller_inventory_sources controller_job_templates controller_labels controller_notification_templates controller_organizations controller_projects controller_roles controller_schedules controller_settings controller_teams controller_users controller_workflow_job_templates"
export_specific_tags["Gateway"]="gateway_applications gateway_authenticator_maps gateway_authenticators gateway_http_ports gateway_organizations gateway_role_definitions gateway_role_team_assignments gateway_role_user_assignments gateway_routes gateway_service_clusters gateway_service_keys gateway_service_nodes gateway_services gateway_settings gateway_teams gateway_users"
export_specific_tags["Event-Driven Ansible (EDA)"]="eda_credentials eda_credential_types eda_decision_environments eda_event_streams eda_projects eda_rulebook_activations"
export_specific_tags["Automation Hub (HUB)"]="hub_collections hub_collection_remotes hub_collection_repositories hub_ee_images hub_ee_registries hub_ee_repositories hub_namespaces"

# --- Import Tags ---

import_category_tags=() # No category tags for import in this version

import_specific_tags_categories=(
  "Controller"
  "Gateway"
  "Event-Driven Ansible (EDA)"
  "Automation Hub (HUB)"
)

declare -A import_specific_tags
import_specific_tags["Controller"]="controller_credential_input_sources controller_credential_types controller_credentials controller_execution_environments controller_host_groups controller_hosts controller_instance_groups controller_instances controller_inventories controller_inventory_sources controller_job_templates controller_labels controller_notification_templates controller_projects controller_roles controller_schedules controller_settings controller_workflow_job_templates"
import_specific_tags["Gateway"]="gateway_applications gateway_authenticator_maps gateway_authenticators gateway_http_ports gateway_organizations gateway_role_definitions gateway_role_team_assignments gateway_role_user_assignments gateway_routes gateway_service_clusters gateway_service_keys gateway_service_nodes gateway_services gateway_settings gateway_teams gateway_users"
import_specific_tags["Event-Driven Ansible (EDA)"]="eda_credential_types eda_credentials eda_decision_environments eda_event_streams eda_projects eda_rulebook_activations"
import_specific_tags["Automation Hub (HUB)"]="hub_collections hub_collection_remotes hub_collection_repositories hub_ee_images hub_ee_registries hub_ee_repositories hub_namespaces"

# AAP 2.6 folders (standard layout). Orgs/teams/users/applications live in aap_*.d;
# legacy gateway_*/controller_* folders for those types are still read on import.
aap_folders_needed=(
    aap_applications.d
    aap_organizations.d
    aap_teams.d
    aap_user_accounts.d
    controller_credential_input_sources.d
    controller_credential_types.d
    controller_credentials.d
    controller_execution_environments.d
    controller_groups.d
    controller_hosts.d
    controller_instance_groups.d
    controller_instances.d
    controller_inventories.d
    controller_inventory_sources.d
    controller_job_templates.d
    controller_labels.d
    controller_notification_templates.d
    controller_projects.d
    controller_roles.d
    controller_schedules.d
    controller_settings.d
    controller_workflow_job_templates.d
    eda_credential_types.d
    eda_credentials.d
    eda_decision_environments.d
    eda_event_streams.d
    eda_projects.d
    eda_rulebook_activations.d
    gateway_authenticator_maps.d
    gateway_authenticators.d
    gateway_http_ports.d
    gateway_role_definitions.d
    gateway_role_team_assignments.d
    gateway_role_user_assignments.d
    gateway_routes.d
    gateway_service_clusters.d
    gateway_service_keys.d
    gateway_service_nodes.d
    gateway_services.d
    gateway_settings.d
    hub_collection_remotes.d
    hub_collection_repositories.d
    hub_collections.d
    hub_ee_images.d
    hub_ee_registries.d
    hub_ee_repositories.d
    hub_namespaces.d
)